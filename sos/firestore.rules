rules_version = '2';
// 공동육아 SOS 달력 · Firestore 보안 규칙
// Firebase 콘솔 > Firestore Database > 규칙 탭에 이 내용을 그대로 붙여넣고 "게시"하세요.
//
// 핵심 원리:
//  - 방 위치 이름 = "방 코드 + 비밀번호"로 만든 64글자 열쇠. 비밀번호를 모르면 위치를 모름.
//  - 방 목록 전체 보기(list)는 막아서, 위치를 모르는 사람은 아무 방도 찾을 수 없음.
//  - 표시(🆘/✋)는 올린 사람만 지울 수 있음. 수정은 불가(지우고 다시 올리기).
//  - 글자 수 제한으로 엉뚱한 큰 데이터가 쌓이지 않게 함.
service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{roomKey} {
      allow get: if request.auth != null;
      allow list, update, delete: if false;
      allow create: if request.auth != null
        && roomKey.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 30
        && request.resource.data.createdAt == request.time;

      match /marks/{markId} {
        allow read: if request.auth != null;
        allow update: if false;
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
        allow create: if request.auth != null
          && exists(/databases/$(database)/documents/rooms/$(roomKey))
          && request.resource.data.keys().hasOnly(['date', 'type', 'nick', 'time', 'memo', 'uid', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.type in ['sos', 'can']
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.nick is string
          && request.resource.data.nick.size() >= 1
          && request.resource.data.nick.size() <= 12
          && request.resource.data.time is string
          && request.resource.data.time.size() <= 20
          && request.resource.data.memo is string
          && request.resource.data.memo.size() <= 60
          && request.resource.data.createdAt == request.time;
      }
    }
  }
}
