rules_version = '2';
// 공동육아 SOS · Firestore 보안 규칙
// Firebase 콘솔 > Firestore Database > 규칙 탭에 이 내용을 그대로 붙여넣고 "게시"하세요.
//
// 구조: rooms/{방 열쇠}                — 방 이름
//       rooms/{방 열쇠}/opinions/{id}  — 모임 (topic 'meet'), 아래 comments 에 댓글
//       rooms/{방 열쇠}/sos/{날짜}      — 시간별 SOS 예약 수 (h8 ~ h20)
//       rooms/{방 열쇠}/plays/{id}     — 엄마 아빠가 추가한 놀이
// 방 열쇠 = SHA-256("방코드:비밀번호"). 비밀번호를 모르면 열쇠를 모르고, 방 목록 보기(list)는 막혀 있어서
// 다른 방을 찾을 수 없어요. 방 안의 규칙은 동래아 공동육아 사이트와 같아요.
// 지난 모임·댓글·SOS는 expireAt(날짜+7일)이 지나면 Firestore TTL이 자동으로 지워요 (콘솔에서 TTL 정책 설정 필요).
// 방은 방장이 앱에서 지울 수 있어요: '지워짐' 표시 → 방 안의 기록을 실제로 삭제. 지워진 방은 아무도 읽거나 쓸 수 없어요.
// 문제 글은 Firebase 콘솔에서 직접 지워요.
service cloud.firestore {
  match /databases/{database}/documents {

    // 자동 삭제 시각(expireAt): 날짜 칸이어야 하고, 너무 먼 미래는 안 됨 (예약은 1주일까지라 20일이면 넉넉)
    function expireOk(d) {
      return !('expireAt' in d) || (d.expireAt is timestamp && d.expireAt <= request.time + duration.value(20, 'd'));
    }
    // 방장이 지운 방인지 (지운 방의 기록은 지울 수 있어요)
    function roomDeleted(roomKey) {
      return get(/databases/$(database)/documents/rooms/$(roomKey)).data.get('deleted', false) == true;
    }
    // 방이 있고, 방장이 지우지 않았는지
    function roomAlive(roomKey) {
      return exists(/databases/$(database)/documents/rooms/$(roomKey))
        && get(/databases/$(database)/documents/rooms/$(roomKey)).data.get('deleted', false) == false;
    }

    match /rooms/{roomKey} {
      allow get: if true;
      allow list, delete: if false;
      allow create: if roomKey.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['name', 'oh', 'createdAt'])
        && (!('oh' in request.resource.data)
            || (request.resource.data.oh is string && request.resource.data.oh.size() == 64))
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 30
        && request.resource.data.createdAt == request.time;
      // 방 지우기: 방장 열쇠(k)의 지문이 oh 와 맞으면 '지워짐' 표시 + 방 이름 비우기 (되돌릴 수 없음)
      //  - 방장 열쇠(oh) 없이 만든 예전 방은 비밀번호를 아는 사람 누구나 지울 수 있어요
      allow update: if resource.data.get('deleted', false) == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'name', 'k'])
        && request.resource.data.deleted == true
        && request.resource.data.name == ''
        && request.resource.data.k is string
        && (!('oh' in resource.data)
            || hashing.sha256(request.resource.data.k).toHexString().lower() == resource.data.oh);

      // 모임
      match /opinions/{id} {
        allow read: if roomAlive(roomKey);
        allow delete: if roomDeleted(roomKey);
        allow create: if roomAlive(roomKey)
          && request.resource.data.keys().hasOnly(['topic', 'text', 'play', 'date', 'slot', 'host', 'joins', 'maybes', 'nos', 'expireAt', 'createdAt'])
          && expireOk(request.resource.data)
          && request.resource.data.topic in ['habit', 'dev', 'meet', 'free']
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && (!('play' in request.resource.data)
              || (request.resource.data.play is string && request.resource.data.play.size() <= 40))
          && (!('date' in request.resource.data)
              || (request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && (!('slot' in request.resource.data)
              || request.resource.data.slot in ['9시', '10시', '11시', '12시', '13시', '14시', '15시', '16시', '17시', '18시', '19시', '20시'])
          && (!('host' in request.resource.data)
              || (request.resource.data.host is string && request.resource.data.host.size() > 0 && request.resource.data.host.size() <= 20))
          && (!('joins' in request.resource.data) || request.resource.data.joins == 0)
          && (!('maybes' in request.resource.data) || request.resource.data.maybes == 0)
          && (!('nos' in request.resource.data) || request.resource.data.nos == 0)
          && request.resource.data.createdAt == request.time;
        // 참석(joins)·미확정(maybes)·불참(nos): 하나를 1 올리기 / 1 내리기(취소, 0 아래 불가) / 하나 내리고 하나 올리기(바꾸기)
        // 모임 취소: cancelled 를 true 로 한 번만 바꾸기 (되돌릴 수 없음)
        function up(f) { return request.resource.data.get(f, 0) == resource.data.get(f, 0) + 1; }
        function down(f) { return resource.data.get(f, 0) >= 1 && request.resource.data.get(f, 0) == resource.data.get(f, 0) - 1; }
        function voteOk(keys) {
          return (keys.hasOnly(['joins']) && (up('joins') || down('joins'))) || (keys.hasOnly(['maybes']) && (up('maybes') || down('maybes'))) || (keys.hasOnly(['nos']) && (up('nos') || down('nos')))
            || (keys.hasOnly(['joins', 'maybes']) && keys.size() == 2 && ((up('joins') && down('maybes')) || (down('joins') && up('maybes'))))
            || (keys.hasOnly(['joins', 'nos']) && keys.size() == 2 && ((up('joins') && down('nos')) || (down('joins') && up('nos'))))
            || (keys.hasOnly(['maybes', 'nos']) && keys.size() == 2 && ((up('maybes') && down('nos')) || (down('maybes') && up('nos'))));
        }
        allow update: if roomAlive(roomKey) && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cancelled'])
            && request.resource.data.cancelled == true && resource.data.topic == 'meet')
          || voteOk(request.resource.data.diff(resource.data).affectedKeys()));

        // 모임 댓글: 쓴 휴대폰만 고치거나 지울 수 있어요 (비밀값의 지문 kh 로 확인)
        match /comments/{cid} {
          allow read: if roomAlive(roomKey);
          allow delete: if roomDeleted(roomKey);
          allow create: if roomAlive(roomKey)
            && request.resource.data.keys().hasOnly(['text', 'createdAt', 'kh', 'expireAt'])
            && expireOk(request.resource.data)
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 300
            && (!('kh' in request.resource.data)
                || (request.resource.data.kh is string && request.resource.data.kh.size() == 64))
            && request.resource.data.createdAt == request.time;
          allow update: if roomAlive(roomKey)
            && resource.data.get('kh', '') != ''
            && resource.data.get('deleted', false) == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'k', 'kh', 'deleted', 'editedAt'])
            && request.resource.data.k is string
            && hashing.sha256(request.resource.data.k).toHexString().lower() == resource.data.kh
            && request.resource.data.kh is string
            && request.resource.data.kh.size() == 64
            && request.resource.data.kh != resource.data.kh
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 300
            && ((request.resource.data.get('deleted', false) == true && request.resource.data.text == '')
                || (request.resource.data.get('deleted', false) == false && request.resource.data.text.size() > 0))
            && request.resource.data.editedAt == request.time;
        }
      }

      // 🆘 SOS 예약: 날짜별 문서에 시간(h8~h20) 하나만 1씩 올리기(예약) 또는 내리기(취소, 0 아래로는 안 됨)
      //  + 자동 삭제 시각(expireAt)은 함께 적어도 돼요
      match /sos/{day} {
        function sosCreateOk(ks) {
          return ks.size() >= 1 && ks.size() <= 2 && ((ks.hasOnly(['h8', 'expireAt']) && request.resource.data.h8 == 1) || (ks.hasOnly(['h9', 'expireAt']) && request.resource.data.h9 == 1) || (ks.hasOnly(['h10', 'expireAt']) && request.resource.data.h10 == 1) || (ks.hasOnly(['h11', 'expireAt']) && request.resource.data.h11 == 1) || (ks.hasOnly(['h12', 'expireAt']) && request.resource.data.h12 == 1) || (ks.hasOnly(['h13', 'expireAt']) && request.resource.data.h13 == 1) || (ks.hasOnly(['h14', 'expireAt']) && request.resource.data.h14 == 1) || (ks.hasOnly(['h15', 'expireAt']) && request.resource.data.h15 == 1) || (ks.hasOnly(['h16', 'expireAt']) && request.resource.data.h16 == 1) || (ks.hasOnly(['h17', 'expireAt']) && request.resource.data.h17 == 1) || (ks.hasOnly(['h18', 'expireAt']) && request.resource.data.h18 == 1) || (ks.hasOnly(['h19', 'expireAt']) && request.resource.data.h19 == 1) || (ks.hasOnly(['h20', 'expireAt']) && request.resource.data.h20 == 1));
        }
        function sosUpdateOk(ch) {
          return ch.size() == 1 && ((ch.hasOnly(['h8']) && (request.resource.data.h8 == resource.data.get('h8', 0) + 1 || (resource.data.get('h8', 0) >= 1 && request.resource.data.h8 == resource.data.get('h8', 0) - 1)))
            || (ch.hasOnly(['h9']) && (request.resource.data.h9 == resource.data.get('h9', 0) + 1 || (resource.data.get('h9', 0) >= 1 && request.resource.data.h9 == resource.data.get('h9', 0) - 1)))
            || (ch.hasOnly(['h10']) && (request.resource.data.h10 == resource.data.get('h10', 0) + 1 || (resource.data.get('h10', 0) >= 1 && request.resource.data.h10 == resource.data.get('h10', 0) - 1)))
            || (ch.hasOnly(['h11']) && (request.resource.data.h11 == resource.data.get('h11', 0) + 1 || (resource.data.get('h11', 0) >= 1 && request.resource.data.h11 == resource.data.get('h11', 0) - 1)))
            || (ch.hasOnly(['h12']) && (request.resource.data.h12 == resource.data.get('h12', 0) + 1 || (resource.data.get('h12', 0) >= 1 && request.resource.data.h12 == resource.data.get('h12', 0) - 1)))
            || (ch.hasOnly(['h13']) && (request.resource.data.h13 == resource.data.get('h13', 0) + 1 || (resource.data.get('h13', 0) >= 1 && request.resource.data.h13 == resource.data.get('h13', 0) - 1)))
            || (ch.hasOnly(['h14']) && (request.resource.data.h14 == resource.data.get('h14', 0) + 1 || (resource.data.get('h14', 0) >= 1 && request.resource.data.h14 == resource.data.get('h14', 0) - 1)))
            || (ch.hasOnly(['h15']) && (request.resource.data.h15 == resource.data.get('h15', 0) + 1 || (resource.data.get('h15', 0) >= 1 && request.resource.data.h15 == resource.data.get('h15', 0) - 1)))
            || (ch.hasOnly(['h16']) && (request.resource.data.h16 == resource.data.get('h16', 0) + 1 || (resource.data.get('h16', 0) >= 1 && request.resource.data.h16 == resource.data.get('h16', 0) - 1)))
            || (ch.hasOnly(['h17']) && (request.resource.data.h17 == resource.data.get('h17', 0) + 1 || (resource.data.get('h17', 0) >= 1 && request.resource.data.h17 == resource.data.get('h17', 0) - 1)))
            || (ch.hasOnly(['h18']) && (request.resource.data.h18 == resource.data.get('h18', 0) + 1 || (resource.data.get('h18', 0) >= 1 && request.resource.data.h18 == resource.data.get('h18', 0) - 1)))
            || (ch.hasOnly(['h19']) && (request.resource.data.h19 == resource.data.get('h19', 0) + 1 || (resource.data.get('h19', 0) >= 1 && request.resource.data.h19 == resource.data.get('h19', 0) - 1)))
            || (ch.hasOnly(['h20']) && (request.resource.data.h20 == resource.data.get('h20', 0) + 1 || (resource.data.get('h20', 0) >= 1 && request.resource.data.h20 == resource.data.get('h20', 0) - 1))));
        }
        allow read: if roomAlive(roomKey);
        allow delete: if roomDeleted(roomKey);
        allow create: if roomAlive(roomKey)
          && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && expireOk(request.resource.data)
          && sosCreateOk(request.resource.data.keys());
        allow update: if roomAlive(roomKey)
          && expireOk(request.resource.data)
          && sosUpdateOk(request.resource.data.diff(resource.data).affectedKeys().difference(['expireAt'].toSet()));
      }

      // 놀이 추가: 누구나 올리기, 수정·삭제 불가
      match /plays/{id} {
        allow read: if roomAlive(roomKey);
        allow update: if false;
        allow delete: if roomDeleted(roomKey);
        allow create: if roomAlive(roomKey)
          && request.resource.data.keys().hasOnly(['name', 'kind', 'cat', 'say', 'how', 'items', 'createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 30
          && request.resource.data.kind in ['habit', 'dev']
          && (!('cat' in request.resource.data)
              || (request.resource.data.cat is string && request.resource.data.cat.size() <= 20))
          && (!('say' in request.resource.data)
              || (request.resource.data.say is string && request.resource.data.say.size() <= 40))
          && request.resource.data.how is string
          && request.resource.data.how.size() > 0
          && request.resource.data.how.size() <= 200
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 10
          && request.resource.data.createdAt == request.time;
      }
    }
  }
}
